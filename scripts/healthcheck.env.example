# /etc/ifa/healthcheck.env - copy to that path on the VPS + fill in real dates.
# Sourced by /opt/ifa-backtest-product/scripts/ifa-healthcheck.sh.
#
# Every variable here has a sensible default in the script; override any of
# them here to fit the environment.

# Alert when disk usage on / >= this percent.
DISK_THRESHOLD_PCT=85

# Alert when RAM usage >= this percent (computed as (Total - Available) / Total).
RAM_THRESHOLD_PCT=90

# Fire renewal reminders when the OVH VPS + Hostinger domain are exactly this many
# days out (space-separated list). Choose thresholds so we get warned before it
# becomes urgent.
RENEWAL_WARN_DAYS="30 14 7 3 1"

# Fire cert-expiring alerts when the SSL cert has fewer than this many days left.
# certbot should auto-renew at 30 days, so 30 here catches renewal failures.
CERT_WARN_DAYS=30

# Docker container names that MUST be running + healthy. Anything not in the
# list is ignored (WordPress, sidecar projects, etc.).
CONTAINERS="ifa-postgres ifa-backend ifa-frontend ifa-vam-engine"

# Domain to check the SSL certificate expiry for.
CERT_DOMAIN=backtestingengine.insightfusionanalytics.com

# YYYY-MM-DD. Update these after each renewal.
# Today's outage was because we didn't know 14/09 was the renewal date.
VPS_RENEWAL_DATE=2026-10-02
DOMAIN_RENEWAL_DATE=
