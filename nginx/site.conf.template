# Host-side Nginx config — drop into /etc/nginx/sites-available/ on the droplet
# Replace ${DOMAIN} with your actual domain (e.g. backtestingengine.insightfusionanalytics.com)
# After:
#   ln -s /etc/nginx/sites-available/ifa-backtest /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx
#   certbot --nginx -d ${DOMAIN}   # SSL via Let's Encrypt

# Rate limit zone for auth endpoints (defence-in-depth alongside slowapi at
# the app layer). 10r/m per client IP — a legitimate user won't retry that fast.
limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=10r/m;

server {
    listen 80;
    server_name ${DOMAIN};

    # ---- Security headers (applied to every response, including errors) ----
    # HSTS — force HTTPS for 6 months, include subdomains, mark for browser preload list.
    add_header Strict-Transport-Security "max-age=15552000; includeSubDomains; preload" always;
    # Anti-clickjacking — allow same-origin framing so the admin content
    # editor can preview the client dashboard in an iframe. Third-party
    # framing is still blocked.
    add_header X-Frame-Options "SAMEORIGIN" always;
    # Freeze MIME type sniffing (helps CSP + defence against upload tricks).
    add_header X-Content-Type-Options "nosniff" always;
    # Referrer discipline — never leak URLs to third parties.
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # Feature lockdown — deny every powerful browser API we don't use.
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    # Content Security Policy — restrict script/style sources. Firebase (auth) +
    # Supabase (storage) + Sentry (observability) + VAM engine (backtests) allowed.
    # 'unsafe-inline' on styles because Tailwind runtime + inline SVG styles rely on it;
    # scripts are strict — no inline eval.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://apis.google.com https://www.gstatic.com https://*.firebaseapp.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://*.googleapis.com https://*.firebaseapp.com https://*.firebaseio.com wss://*.firebaseio.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://*.supabase.co wss://*.supabase.co https://*.sentry.io https://backtestravi.insightfusionanalytics.com; frame-src 'self' https://*.firebaseapp.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" always;

    # Frontend container (Docker bridge network)
    location / {
        proxy_pass http://127.0.0.1:5173;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Auth endpoint — nginx-level rate limit as first line of defence.
    # burst=5 nodelay allows a small legitimate burst without queueing latency;
    # slowapi inside the app enforces the stricter per-IP cap after this.
    location = /api/v1/auth/login {
        limit_req zone=auth_limit burst=5 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Backend API — same domain, /api path
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        client_max_body_size 25M;     # strategy uploads up to 25MB
    }

    # Healthcheck passthrough (for uptime probes)
    location = /healthz {
        proxy_pass http://127.0.0.1:8000/healthz;
        access_log off;
    }
}
