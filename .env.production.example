# ═══════════════════════════════════════════════════════════════════════
#  IFA Backtest Engine — production environment template
#
#  Copy to .env.production on the VPS + fill in EVERY <angle-bracket>
#  placeholder. Never commit this file — it stays gitignored via *.local
#  and the explicit .env.production entry.
#
#  ⚠️  Meeting 2026-07-09 context: the previous origin repo was public for
#      7 weeks with real credentials embedded. Every value below MUST be
#      a freshly rotated one, not a copy from the compromised repo.
# ═══════════════════════════════════════════════════════════════════════

APP_ENV=production
APP_NAME=ifa-backtest-product
API_PREFIX=/api/v1

# Random 32+ char secret — generate with: openssl rand -hex 32
APP_SECRET=<32-char-random-hex>

# ── DOMAIN ──────────────────────────────────────────────────────────────
# The domain you point at 149.56.99.200 via A record (e.g. insightfusionanalytics.in).
# Used in every VITE_API_BASE_URL + CORS + nginx config.
ALLOWED_ORIGINS=https://<your-domain>

# ── Supabase (rotated keys — see security audit) ────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_REST_URL=https://<project-ref>.supabase.co/rest/v1/
SUPABASE_ANON_KEY=<rotated-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<rotated-service-role-key>
SUPABASE_PUBLISHABLE_KEY=<rotated-publishable-key>
SUPABASE_SECRET_KEY=<rotated-secret-key>
SUPABASE_BUCKET=ifa-private
STORAGE_BACKEND=supabase

# Postgres — usually the Supabase DB. Rotate the password in Supabase → Project settings → Database.
DATABASE_URL=postgresql+asyncpg://postgres:<rotated-supabase-pw>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:<rotated-supabase-pw>@db.<project-ref>.supabase.co:5432/postgres

# ── Firebase Admin SDK ──────────────────────────────────────────────────
# The FRESH service-account JSON (not the one that was in the compromised
# git history) sits at backend/secrets/firebase-admin.json — bind-mounted
# into the backend container. Regenerate in Firebase console → Service
# accounts → Generate new private key.
FIREBASE_PROJECT_ID=ifa-backtest-product
FIREBASE_CREDENTIALS_PATH=./backend/secrets/firebase-admin.json

# ── Firebase Web SDK (frontend build-time) ──────────────────────────────
# Restrict the Web API key in Google Cloud Console → APIs & Services →
# Credentials → HTTP referrers: https://<your-domain>/*, http://localhost:*/*
# Restrict APIs to: Identity Toolkit API.
VITE_FIREBASE_API_KEY=<web-api-key>
VITE_FIREBASE_AUTH_DOMAIN=ifa-backtest-product.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ifa-backtest-product
VITE_FIREBASE_STORAGE_BUCKET=ifa-backtest-product.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=<sender-id>
VITE_FIREBASE_APP_ID=<app-id>

# ── Rotated user passwords (seeded on first run) ────────────────────────
MAIN_ADMIN_EMAIL=<main-admin-email>
MAIN_ADMIN_INITIAL_PASSWORD=<NEW-rotated-pw>
DEMO_CLIENT_PASSWORD=<NEW-rotated-pw>
RAVI_INITIAL_PASSWORD=<NEW-rotated-pw>

# ── Frontend build args — the frontend hits <domain>/api/v1 ─────────────
# Must match the domain above.
VITE_API_BASE_URL=https://<your-domain>/api/v1

# ── Sentry (recommended for production) ─────────────────────────────────
SENTRY_DSN_BACKEND=
VITE_SENTRY_DSN_FRONTEND=

# ── Rate limits (per-tier per-endpoint via SlowAPI) ─────────────────────
RATE_LIMIT_ANON=60/minute
RATE_LIMIT_TIER1=120/minute
RATE_LIMIT_TIER2=300/minute
RATE_LIMIT_TIER3=600/minute
